# STAGING values for this app: what the Vercel "Preview" environment must
# hold so every PR preview talks to staging, never production
# (gd-proto/docs/runbooks/staging-environment.md). Also usable locally:
# copy to .env.staging.local and run `npx vite dev --mode staging`.
# CI's preview-env job pulls the real Preview vars and fails the PR if any
# of them is a production value (scripts/check-env.js).
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=https://placeme-server-staging.onrender.com
# Leave PostHog empty on staging so previews don't mix into production analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
