# ── Supabase ──────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard. The anon/publishable
# key is safe to expose client-side — that's what it's for.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# gd-proto/apps/server's URL (local dev default shown; point at the
# deployed backend origin in production)
VITE_API_URL=http://localhost:3000

# ── Analytics (optional) ─────────────────────────────────────────────
# PostHog project API key (Project Settings → API Keys, free tier: 1M
# events/month). Analytics is a no-op everywhere -- local dev, CI, tests
# -- until this is actually set; nothing throws or requires it, unlike
# the Supabase vars above. See src/lib/analytics.ts.
VITE_POSTHOG_KEY=
# Defaults to PostHog Cloud US (https://us.i.posthog.com) if unset; use
# https://eu.i.posthog.com for an EU-hosted project instead.
VITE_POSTHOG_HOST=
